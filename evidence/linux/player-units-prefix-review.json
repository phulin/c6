  "validator_source": "from pathlib import Path\nimport gzip,json,subprocess,hashlib,sys,struct\nsys.path.insert(0,'tools/linux');from player_districts_audit import FIXTURES\nroot=Path('/home/phulin/c6-ghidra');sha=lambda b:hashlib.sha256(b).hexdigest();results=[];old=json.loads(Path('/tmp/c6-units-prefix-review.json').read_text())\nkeys=['map_end','consumed','items_used','post_map_items','tail_bytes','unfinished_player_entries','saved_is_alive','through_map_logical_allocation','era_hash','game_era_hash','unit_capacity','unit_current_id_bits','unit_free_head','unit_free_tail','unit_free_count','unit_live_count','culture_end','espionage_end','religion_end','resources_end','stats_end','techs_end','treasury_end','units_end','eras_end','espionage_bytes','espionage_items','religion_bytes','religion_items','resources_bytes','resources_items','stats_bytes','stats_items','techs_bytes','techs_items','treasury_bytes','treasury_items','units_bytes','units_items','eras_bytes','eras_items']\nfor index,(identity,name,h)in enumerate(FIXTURES):\n data=gzip.decompress((root/'evidence/linux-game-load/canonical'/(identity+'.bin.gz')).read_bytes());assert sha(data)==identity;raw=gzip.decompress((root/'evidence/linux-save-normalization/checkpoint-203-owners'/name).read_bytes());assert sha(raw)==h;owners=[json.loads(x)for x in raw.splitlines()];owners=[r for r in owners if r.get('event')=='owner'and r.get('save')==1];output=subprocess.check_output(['/tmp/c6-eras-prefix-review-candidate'],input=data);header,observations,encoded=output.split(b'\\n',2);values=list(map(int,header.split()));assert len(values)==len(keys);r=dict(zip(keys,values));obs=list(map(int,observations.split()))\n points=[r[k]for k in ['culture_end','espionage_end','religion_end','resources_end','stats_end','techs_end','treasury_end','units_end']]\n for owner,start,end in zip(['Espionage','Religion','Resources','Stats','Techs','Treasury','Units'],points,points[1:]):assert any(c['owner']=='GameCore::Player::'+owner and c['start']==start and c['end']==end for c in owners),owner\n ur=next(c for c in owners if c['owner']=='GameCore::Player::Units'and c['start']==r['treasury_end']and c['end']==r['units_end']);tr=next(c for c in owners if c['owner']=='GameCore::Player::Trade'and c['start']==r['consumed']and c['parent']==ur['parent']);assert r['eras_bytes']==12 and r['eras_items']==0 and r['units_end']+12==r['consumed'];assert struct.unpack_from('<III',data,r['units_end'])==(2,r['era_hash'],r['game_era_hash'])\n assert struct.unpack_from('<IIIII',data,r['treasury_end'])==(22,65537,16,r['unit_capacity'],r['unit_live_count']);assert len(obs)==r['unit_live_count']*3+r['unit_free_count'];cursor=r['treasury_end']+20;unit_cuts={c['start']:c['end']for c in owners if c['owner']=='GameCore::Unit::Instance'}\n for n in range(r['unit_live_count']):\n  start=cursor+4;assert start in unit_cuts;expected=[struct.unpack_from('<i',data,cursor)[0],struct.unpack_from('<I',data,start+4)[0],struct.unpack_from('<i',data,start+40)[0]];assert obs[n*3:n*3+3]==expected;cursor=unit_cuts[start]\n assert struct.unpack_from('<IIII',data,cursor)==(r['unit_current_id_bits'],r['unit_free_count'],r['unit_free_head'],r['unit_free_tail']);links=list(struct.unpack_from('<'+'I'*r['unit_free_count'],data,cursor+16));assert obs[r['unit_live_count']*3:]==links\n assert encoded==data[r['map_end']:r['consumed']];units_digest=sha(encoded[:r['units_end']-r['map_end']]);assert units_digest==old['fixtures'][index]['post_map_sha256'];assert r['post_map_items']==old['fixtures'][index]['post_map_items'];assert r['units_end']==old['fixtures'][index]['consumed']\n r.update(stream_sha256=identity,trace_sha256=h,post_map_sha256=sha(encoded),units_prefix_sha256=units_digest,tail_sha256=sha(data[r['consumed']:]),native_eras_entry_observed=False,native_trade_entry_observed=True,eras_bracket_matching_native_parent=ur['parent'],typed_unit_identity_and_free_links_sha256=sha(json.dumps(obs,separators=(',',':')).encode()));results.append(r)\nreport={'source_commit':'be8573e','candidate_sha256':sha(Path('/tmp/c6-eras-prefix-review-candidate').read_bytes()),'harness_sha256':sha(Path('review_composition.rs').read_bytes()),'harness_source':Path('review_composition.rs').read_text(),'fixtures':results,'exact_shared_and_player_caps_pass':True,'one_short_shared_and_player_caps_refuse':True,'ten_actual_prefix_truncations_refuse':True,'exact_and_one_short_encoding_caps_checked':True,'tail_borrow_asserted':True,'all_seven_hooked_native_owner_cuts_match':True,'eras_bracketed_by_matching_parent_units_and_trade':True,'earlier_units_digest_and_item_counts_match':True,'all_first_player_unit_ids_owners_slots_free_links_match':True};Path('/tmp/c6-eras-prefix-review.json').write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps(results))\n",
