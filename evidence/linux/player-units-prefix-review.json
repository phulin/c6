    "harness_source": "use c6_core::{core_stream::ThroughFirstPlayer,core_player::Boundary,map,unit};\nuse std::io::{Read,Write};\nfn main(){\n let mut input=Vec::new();std::io::stdin().read_to_end(&mut input).unwrap();\n let v=ThroughFirstPlayer::decode(&input,map::Limits::default(),unit::Limits::default()).unwrap();\n assert_eq!(v.player_prefix.boundary,Boundary::PlayerTrade);\n assert_eq!(v.tail,&input[v.consumed..]);assert!(std::ptr::eq(v.tail.as_ptr(),input[v.consumed..].as_ptr()));\n let(encoded,post_items)=v.player_prefix.encode_prefix_with_items(unit::Limits::default()).unwrap();\n assert_eq!(encoded,input[v.core.consumed..v.consumed]);assert_eq!(v.items_used,v.core.items_used+post_items);\n let p=v.player_prefix.first_player.as_ref().unwrap();\n let parts=[p.espionage.encode_with_items(unit::Limits::default()).unwrap(),p.religion.encode_with_items(unit::Limits::default()).unwrap(),p.resources.encode_with_items(unit::Limits::default()).unwrap(),p.stats.encode_with_items(unit::Limits::default()).unwrap(),p.techs.encode_with_items(unit::Limits::default()).unwrap(),p.treasury.encode_with_items(unit::Limits::default()).unwrap(),p.units.encode_with_items(unit::Limits::default()).unwrap(),p.eras.encode_with_items(unit::Limits::default()).unwrap()];\n let mut cursors=vec![v.consumed-parts.iter().map(|x|x.0.len()).sum::<usize>()];for(b,_)in &parts{cursors.push(cursors.last().unwrap()+b.len());}\n let shared=map::Limits{max_bytes:v.consumed,max_items:v.items_used,max_allocation:v.core.logical_allocation_used,..map::Limits::default()};\n let player=unit::Limits{max_bytes:encoded.len(),max_items:post_items};\n assert!(ThroughFirstPlayer::decode(&input,shared,player).is_ok());\n for s in[map::Limits{max_bytes:shared.max_bytes-1,..shared},map::Limits{max_items:shared.max_items-1,..shared}]{assert!(ThroughFirstPlayer::decode(&input,s,player).is_err());}\n for l in[unit::Limits{max_bytes:player.max_bytes-1,..player},unit::Limits{max_items:player.max_items-1,..player}]{assert!(ThroughFirstPlayer::decode(&input,shared,l).is_err());}\n for cut in std::iter::once(v.core.consumed).chain(cursors[..cursors.len()-1].iter().copied()).chain(std::iter::once(v.consumed-1)){assert!(ThroughFirstPlayer::decode(&input[..cut],map::Limits::default(),unit::Limits::default()).is_err());}\n\n let(out,ei)=v.player_prefix.encode_prefix_with_items(player).unwrap();assert_eq!(out,encoded);assert_eq!(ei,post_items);\n for l in[unit::Limits{max_bytes:player.max_bytes-1,..player},unit::Limits{max_items:player.max_items-1,..player}]{assert!(v.player_prefix.encode_prefix_with_items(l).is_err());}\n let mut fields=vec![v.core.consumed,v.consumed,v.items_used,post_items,v.tail.len(),v.player_prefix.unfinished_player_entries as usize,usize::from(p.header.saved_is_alive()),v.core.logical_allocation_used];fields.extend([p.eras.era_hash as usize,p.eras.game_era_hash as usize,p.units.records.capacity as usize,p.units.records.current_id_bits as usize,p.units.records.free_head as usize,p.units.records.free_tail as usize,p.units.records.free_links.len(),p.units.records.entries.len()]);fields.extend(cursors);\n for(b,i)in &parts{fields.push(b.len());fields.push(*i);}\n println!(\"{}\",fields.iter().map(usize::to_string).collect::<Vec<_>>().join(\" \"));let mut observations=Vec::new();for e in &p.units.records.entries{observations.extend([i64::from(e.index),i64::from(e.value.id),i64::from(e.value.e_owner)]);}observations.extend(p.units.records.free_links.iter().map(|x|i64::from(*x)));println!(\"{}\",observations.iter().map(i64::to_string).collect::<Vec<_>>().join(\" \"));std::io::stdout().write_all(&encoded).unwrap();\n}\n",
